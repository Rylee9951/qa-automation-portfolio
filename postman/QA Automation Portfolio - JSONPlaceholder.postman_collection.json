    {
      "name": "GET - Retrieve Post by ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Verify successful response",
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "// Verify response contains JSON",
              "pm.test(\"Response is JSON\", function () {",
              "    pm.expect(pm.response.headers.get(\"Content-Type\"))",
              "        .to.include(\"application/json\");",
              "});",
              "",
              "// Verify post ID",
              "pm.test(\"Post ID should equal 1\", function () {",
              "    const post = pm.response.json();",
              "    pm.expect(post.id).to.eql(1);",
              "});",
              "",
              "// Verify required fields",
              "pm.test(\"Post should contain title and body\", function () {",
              "    const post = pm.response.json();",
              "",
              "    pm.expect(post.title).to.be.a(\"string\").and.not.empty;",
              "    pm.expect(post.body).to.be.a(\"string\").and.not.empty;",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://jsonplaceholder.typicode.com/posts/1",
          "protocol": "https",
          "host": [
            "jsonplaceholder",
            "typicode",
            "com"
          ],
          "path": [
            "posts",
            "1"
          ]
        }
      },
      "response": []
    },
    {
      "name": "GET - Retrieve Posts by User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response contains posts\", function () {",
              "    const posts = pm.response.json();",
              "    pm.expect(posts.length).to.be.greaterThan(0);",
              "});",
              "",
              "pm.test(\"All posts belong to user 1\", function () {",
              "    const posts = pm.response.json();",
              "",
              "    pm.expect(",
              "        posts.every(post => post.userId === 1)",
              "    ).to.be.true;",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://jsonplaceholder.typicode.com/posts?userId=1",
          "protocol": "https",
          "host": [
            "jsonplaceholder",
            "typicode",
            "com"
          ],
          "path": [
            "posts"
          ],
          "query": [
            {
              "key": "userId",
              "value": "1"
            }
          ]
        }
      },
      "response": []
