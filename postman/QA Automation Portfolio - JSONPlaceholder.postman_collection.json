              "pm.test(\"Response contains the submitted title\", function () {",
              "    const post = pm.response.json();",
              "",
              "    pm.expect(post.title).to.eql(\"QA Portfolio API Test\");",
              "});",
              "",
              "pm.test(\"Response contains the submitted body\", function () {",
              "    const post = pm.response.json();",
              "",
              "    pm.expect(post.body).to.eql(\"Testing POST requests using Postman.\");",
              "});",
              "",
              "pm.test(\"Response contains a generated ID\", function () {",
              "    const post = pm.response.json();",
              "",
              "    pm.expect(post.id).to.exist;",
              "});"
            ],
